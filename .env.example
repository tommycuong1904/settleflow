NEXT_PUBLIC_APP_NAME=SettleFlow
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_ARC_EXECUTION_MODE=mock
# Server-side key for Circle Wallets execution mode (executionMode=circle_wallet).
# The server account is derived from this private key and must hold native USDC on Arc
# to pay for gas and settle releases. Keep it secret and server-only (never NEXT_PUBLIC_).
# Leave unset to fail explicitly when a circle_wallet release is attempted.
# ARC_SERVER_PRIVATE_KEY=0x...
DATABASE_URL=postgresql://postgres:***@localhost:5432/settleflow?schema=public
# Google OAuth Authorization Code flow (server-only secret; never NEXT_PUBLIC_)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Local/staging first-login policy; use invitations instead of auto-owner in production.
GOOGLE_DEFAULT_WORKSPACE_SLUG=settleflow-demo
GOOGLE_FIRST_LOGIN_ROLE=owner
